{
  "name": "coaching-lol",
  "productName": "Coaching LoL",
  "version": "1.6.16",
  "description": "Suivi privé de coaching League of Legends : parties SoloQ au rôle coaché, objectifs, sessions.",
  "main": "main.js",
  "author": "Theo Fauviaux",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js && node tests/live.js && node tests/moments.js && node tests/replay.js && node tests/players.js && node tests/lp.js && node tests/history.js && node tests/macupdate.js && node tests/cloud.js && node tests/cloud-sql.js && node tests/bookings-sql.js && node tests/reports-sql.js && node tests/analyses-sql.js && node tests/claude.js && node tests/custom.js && node tests/webm.js",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "test:e2e": "node tests/e2e-bookings.js",
    "test:e2e-fiches": "node tests/e2e-fiches.js",
    "test:e2e-live": "node tests/e2e-live.js",
    "test:e2e-analyses": "node tests/e2e-analyses.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.theofauviaux.coachinglol",
    "productName": "Coaching LoL",
    "files": [
      "main.js",
      "preload.js",
      "recorder-preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.sports",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null
    },
    "afterPack": "build/signer-mac.js",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Coaching-LoL-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "theofauviaux-stack",
        "repo": "coaching-lol",
        "releaseType": "release"
      }
    ]
  }
}
